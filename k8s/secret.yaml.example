# Exemplo — NÃO contém credenciais reais.
# Aplique secrets com:  ../FCG.Infra/scripts/apply-secrets.ps1
apiVersion: v1
kind: Secret
metadata:
  name: fcg-users-api-secret
type: Opaque
stringData:
  ConnectionStrings__DefaultConnection: "Host=fcg-postgres;Port=5432;Database=fcg_users;Username=<USER>;Password=<PASSWORD>"
  MessageBusConfigs__Host: "amqp://<USER>:<PASSWORD>@fcg-rabbitmq:5672/"
  Jwt__Key: "<JWT_KEY_MIN_32_CHARS>"
